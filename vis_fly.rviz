Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Best Path1/Offset1
        - /Camera1
        - /Camera1/Visibility1
        - /PointCloud21
        - /PointCloud21/Autocompute Value Bounds1
      Splitter Ratio: 0.550000011920929
    Tree Height: 542
  - Class: rviz/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 252; 233; 79
      Enabled: true
      Head Diameter: 0.20000000298023224
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
      Line Style: Billboards
      Line Width: 0.15000000596046448
      Name: Best Path
      Offset:
        X: 0
        Y: 0
        Z: -0.10000000149011612
      Pose Color: 255; 85; 255
      Pose Style: None
      Queue Size: 1
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic: /trajectory
      Unreliable: false
      Value: true
    - Class: rviz/Camera
      Enabled: true
      Image Rendering: background and overlay
      Image Topic: /rviz_camera/image
      Name: Camera
      Overlay Alpha: 0.30000001192092896
      Queue Size: 1
      Transport Hint: raw
      Unreliable: false
      Value: true
      Visibility:
        Best Path: true
        Marker: false
        PointCloud2: false
        Value: true
      Zoom Factor: 1
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /quadrotor_simulator_so3/uav
      Name: Marker
      Namespaces:
        mesh: true
      Queue Size: 100
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -1
        Value: false
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 10
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: PointCloud2
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.25
      Style: Flat Squares
      Topic: /velodyne_points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 166.029541015625
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.785398006439209
      Focal Point:
        X: -8.417329788208008
        Y: -0.7097088694572449
        Z: -3.8358962535858154
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.4047964811325073
      Target Frame: odom
      Yaw: 2.5973055362701416
    Saved: ~
Window Geometry:
  Camera:
    collapsed: false
  Displays:
    collapsed: false
  Height: 1403
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 2560
  X: 1920
  Y: 0
